		"prose mx-auto w-full max-w-3xl pt-12 text-lg text-slate-900 dark:text-slate-100 prose-headings:font-normal prose-headings:tracking-tighter prose-headings:text-black dark:prose-headings:text-white prose-a:text-slate-500 dark:prose-a:text-slate-400 hover:prose-a:text-black dark:hover:prose-a:text-white prose-blockquote:border-l-slate-950 dark:prose-blockquote:border-l-slate-400 prose-blockquote:text-slate-500 dark:prose-blockquote:text-slate-400 prose-code:text-black dark:prose-code:text-white prose-pre:rounded-3xl prose-li:marker:text-slate-500 dark:prose-li:marker:text-slate-400 prose-strong:text-black dark:prose-strong:text-white",
