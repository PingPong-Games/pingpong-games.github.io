---
// Dark Mode Toggle Component
---

<button
	id="dark-mode-toggle"
	type="button"
	class="relative w-12 h-12 flex items-center justify-center rounded-full transition-all duration-300 hover:bg-gray-200 dark:hover:bg-white/10 hover:ring-2 hover:ring-gray-300 dark:hover:ring-white/20"
	aria-label="Toggle dark mode"
>
	<svg
		id="theme-toggle-dark-icon"
		class="w-5 h-5 transition-opacity duration-200"
		fill="currentColor"
		viewBox="0 0 20 20"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path
			d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
		></path>
	</svg>
	<svg
		id="theme-toggle-light-icon"
		class="w-5 h-5 absolute transition-opacity duration-200"
		fill="currentColor"
		viewBox="0 0 20 20"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path
			d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
			fill-rule="evenodd"
			clip-rule="evenodd"></path>
	</svg>
</button>

<script>
	import { LifecycleManager } from "@/utils/lifecycle-manager";

	const lm = new LifecycleManager();

	lm.onElementLoaded("dark-mode-toggle", (ctx) => {
		const toggle = document.getElementById("dark-mode-toggle");
		const darkIcon = document.getElementById("theme-toggle-dark-icon");
		const lightIcon = document.getElementById("theme-toggle-light-icon");

		if (!toggle || !darkIcon || !lightIcon) return;

		function updateIcons(isDark: boolean) {
			if (isDark) {
				darkIcon.style.opacity = "0";
				lightIcon.style.opacity = "1";
			} else {
				darkIcon.style.opacity = "1";
				lightIcon.style.opacity = "0";
			}
		}

		// Initialize icons based on current theme (default: dark)
		let theme = localStorage.getItem("theme");

		// Set default to dark on first visit
		if (!theme) {
			theme = "dark";
			localStorage.setItem("theme", "dark");
		}

		const isDark = theme === "dark";

		if (isDark && !document.documentElement.classList.contains("dark")) {
			document.documentElement.classList.add("dark");
		}

		updateIcons(isDark);

		ctx?.add(() => {
			toggle?.addEventListener("click", () => {
				const html = document.documentElement;
				const currentTheme = html.classList.contains("dark")
					? "dark"
					: "light";
				const newTheme = currentTheme === "dark" ? "light" : "dark";

				html.classList.remove(currentTheme);
				html.classList.add(newTheme);
				localStorage.setItem("theme", newTheme);

				updateIcons(newTheme === "dark");
			});
		});
	});
</script>

<style>
	#theme-toggle-light-icon {
		opacity: 0;
	}
</style>

