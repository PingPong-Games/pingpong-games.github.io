---
import { getLocalizedSettings } from "@/lib/localization-helpers";

const currentLocale = Astro.currentLocale;

const { footer } = getLocalizedSettings(currentLocale);
---

<footer class="bg-white dark:bg-neutral-900 py-8 px-6">
	<div class="max-w-7xl mx-auto flex flex-col items-center justify-center gap-4">
		<a href="/" class="inline-block">
			<img
				src="/logo.png"
				alt="Company Logo"
				class="w-12 h-12 object-contain dark:brightness-0 dark:invert"
			/>
		</a>
		<p class="text-black/60 dark:text-white/60 text-sm text-center">
			{footer.copyright}
		</p>
	</div>
</footer>

<slot />
